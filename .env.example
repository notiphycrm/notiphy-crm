DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=your_crm_database
DB_USER=root
DB_PASS=

# Login fallback when crm_salesperson table is not available.
DEMO_USER=manager
DEMO_PASSWORD=manager123

# Manager visibility user IDs from crm_salesperson.
MANAGER_IDS=2,8,9

# Optional future AI provider toggle.
AI_ENABLED=0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Session cookie lifetime in seconds (default 604800 = 7 days). Use 0 for browser-session-only cookie.
# Clearing cookies / site data in the browser will still remove the session.
SESSION_COOKIE_LIFETIME=604800
# Cookie path; "/" is recommended so the SPA and /api share the same session.
SESSION_COOKIE_PATH=/
# Lax | Strict | None (None requires HTTPS)
SESSION_COOKIE_SAMESITE=Lax

